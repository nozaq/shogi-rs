{
    "name": "Rust",
    "image": "ghcr.io/bare-devcontainer/rust:trixie",
    "remoteEnv": {
        "EDITOR": "code --wait",
        "VISUAL": "code --wait"
    },
    "postCreateCommand": "rustup show",
    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "EditorConfig.EditorConfig"
            ],
            "settings": {
                "rust-analyzer.checkOnSave.command": "clippy"
            }
        }
    }
}
